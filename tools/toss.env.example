# 이 파일을 복사해서 같은 폴더에 "toss.env" 라는 이름으로 저장하고 값을 채워 주세요.
# toss.env는 GitHub에 올라가지 않아요(.gitignore). 이 예시 파일에는 진짜 키를 쓰지 마세요.

# 토스증권 웹 → 설정 → Open API 에 있는 값
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 사이트에 올릴 때 쓰는 열쇠: Vercel 환경변수 AUTO_TRADE_SECRET과 같은 값
# (cron-job.org에 넣어 둔 주소의 key= 뒤 값과 같아요)
LEDGER_UPLOAD_KEY=

# 보통은 그대로 두면 돼요
LEDGER_URL=https://ledger-invest.vercel.app
FROM_DATE=2025-09-01
